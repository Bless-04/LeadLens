# Server only. Create a key in Google AI Studio and add it to your local .env and Vercel project.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Server only. Set a Nominatim-compatible HTTPS reverse endpoint and identify your app.
# For an opt-in, low-traffic demo using public Nominatim, review its policy and configure shared Redis first.
# NOMINATIM_REVERSE_URL=https://nominatim.openstreetmap.org/reverse
# NOMINATIM_USER_AGENT="LeadLens/1.0 (your public contact email or project URL)"
NOMINATIM_REVERSE_URL=
NOMINATIM_USER_AGENT=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public Vite settings. Change attribution to match your tile provider if you change the URL.
VITE_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_OSM_TILE_ATTRIBUTION="&copy; <a href='https://www.openstreetmap.org/copyright'>OpenStreetMap</a> contributors"
